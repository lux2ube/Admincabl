.verified-reviews { background: rgb(248, 250, 252); border-radius: 20px; margin-top: 48px; padding: 28px; }

.dark .verified-reviews { background: rgb(15, 23, 42); }

.verified-reviews--empty { background: rgb(248, 250, 252); border-radius: 16px; margin-top: 32px; padding: 32px; }

#write-review, .verified-reviews { scroll-margin-top: 84px; }

@media (min-width: 768px) {
  #write-review, .verified-reviews { scroll-margin-top: 120px; }
}

.dark .verified-reviews--empty { background: rgb(15, 23, 42); }

.verified-reviews .section-title { color: rgb(31, 41, 55); margin-bottom: 8px; font-size: 22px; font-weight: 700; }

.dark .verified-reviews .section-title { color: rgb(241, 245, 249); }

.verified-reviews .review-disclosure { color: rgb(100, 116, 139); max-width: 760px; margin: 0px 0px 24px; font-size: 13px; line-height: 1.7; }

.dark .verified-reviews .review-disclosure { color: rgb(148, 163, 184); }

.verified-reviews .empty-state { text-align: center; padding: 40px 20px; }

.verified-reviews .empty-state__icon { margin-bottom: 16px; font-size: 48px; }

.verified-reviews .empty-state__text { color: rgb(107, 114, 128); font-size: 16px; }

.dark .verified-reviews .empty-state__text { color: rgb(148, 163, 184); }

.verified-reviews .aggregate-rating { background: rgb(255, 255, 255); border: 1px solid rgb(238, 242, 247); border-radius: 16px; align-items: center; gap: 18px; margin-bottom: 24px; padding: 20px 24px; display: flex; box-shadow: rgba(16, 24, 40, 0.06) 0px 1px 3px; }

.dark .verified-reviews .aggregate-rating { background: rgb(30, 41, 59); border-color: rgb(51, 65, 85); }

.verified-reviews .aggregate-rating__score { color: rgb(245, 158, 11); font-size: 46px; font-weight: 800; line-height: 1; }

.verified-reviews .aggregate-rating__count { color: rgb(107, 114, 128); margin-top: 6px; font-size: 14px; display: block; }

.dark .verified-reviews .aggregate-rating__count { color: rgb(148, 163, 184); }

.verified-reviews .stars { gap: 2px; display: inline-flex; }

.verified-reviews .star { color: rgb(209, 213, 219); font-size: 18px; line-height: 1; }

.dark .verified-reviews .star { color: rgb(71, 85, 105); }

.dark .verified-reviews .star--filled, .verified-reviews .star--filled { color: rgb(251, 191, 36); }

.verified-reviews .reviews-list { flex-direction: column; gap: 14px; display: flex; }

.verified-reviews .review-card { background: rgb(255, 255, 255); border: 1px solid rgb(238, 242, 247); border-radius: 16px; padding: 20px; transition: box-shadow 0.18s, transform 0.18s, border-color 0.18s; box-shadow: rgba(16, 24, 40, 0.05) 0px 1px 2px; }

.verified-reviews .review-card:hover { border-color: rgb(226, 232, 240); transform: translateY(-2px); box-shadow: rgba(16, 24, 40, 0.08) 0px 8px 24px; }

.dark .verified-reviews .review-card { box-shadow: none; background: rgb(30, 41, 59); border-color: rgb(51, 65, 85); }

.dark .verified-reviews .review-card:hover { border-color: rgb(71, 85, 105); }

.verified-reviews .review-header { align-items: flex-start; gap: 12px; margin-bottom: 12px; display: flex; }

.verified-reviews .review-author { align-items: center; gap: 12px; width: 100%; display: flex; }

.verified-reviews .review-avatar { color: rgb(255, 255, 255); text-transform: uppercase; background: linear-gradient(135deg, rgb(99, 102, 241), rgb(139, 92, 246)); border-radius: 50%; flex-shrink: 0; justify-content: center; align-items: center; width: 44px; height: 44px; font-size: 15px; font-weight: 700; display: inline-flex; }

.verified-reviews .review-author__meta { flex-direction: column; gap: 4px; min-width: 0px; display: flex; }

.verified-reviews .review-author__name { color: rgb(31, 41, 55); flex-wrap: wrap; align-items: center; gap: 8px; font-weight: 700; display: inline-flex; }

.dark .verified-reviews .review-author__name { color: rgb(241, 245, 249); }

.verified-reviews .verified-badge { color: rgb(21, 128, 61); white-space: nowrap; background: rgb(220, 252, 231); border-radius: 20px; padding: 2px 8px; font-size: 11px; font-weight: 600; }

.dark .verified-reviews .verified-badge { color: rgb(74, 222, 128); background: rgba(21, 128, 61, 0.18); }

.verified-reviews .review-meta { align-items: center; gap: 10px; display: flex; }

.verified-reviews .review-date { color: rgb(148, 163, 184); font-size: 12.5px; }

.verified-reviews .review-title { color: rgb(31, 41, 55); margin: 4px 0px 8px; font-size: 16px; font-weight: 700; }

.dark .verified-reviews .review-title { color: rgb(226, 232, 240); }

.verified-reviews .review-text { color: rgb(71, 85, 105); white-space: pre-line; margin-bottom: 12px; line-height: 1.75; }

.dark .verified-reviews .review-text { color: rgb(203, 213, 225); }

.verified-reviews .review-pros-cons { flex-wrap: wrap; gap: 24px; margin-bottom: 12px; display: flex; }

.verified-reviews .cons, .verified-reviews .pros { flex: 1 1 0%; min-width: 150px; }

.verified-reviews .cons ul, .verified-reviews .pros ul { margin: 0px; padding: 0px; list-style: none; }

.verified-reviews .pros li { color: rgb(21, 128, 61); padding: 2px 0px; font-size: 14px; }

.verified-reviews .cons li { color: rgb(220, 38, 38); padding: 2px 0px; font-size: 14px; }

.dark .verified-reviews .pros li { color: rgb(74, 222, 128); }

.dark .verified-reviews .cons li { color: rgb(248, 113, 113); }

.verified-reviews .label { margin-left: 4px; font-size: 14px; }

.verified-reviews .review-location { color: rgb(148, 163, 184); align-items: center; gap: 4px; font-size: 12.5px; display: inline-flex; }

.verified-reviews .btn-show-more { color: rgb(79, 70, 229); cursor: pointer; background: rgb(255, 255, 255); border: 1px solid rgb(226, 232, 240); border-radius: 12px; width: 100%; margin-top: 16px; padding: 13px; font-size: 14px; font-weight: 600; transition: 0.18s; }

.verified-reviews .btn-show-more:hover { color: rgb(255, 255, 255); background: rgb(79, 70, 229); border-color: rgb(79, 70, 229); }

.dark .verified-reviews .btn-show-more { color: rgb(165, 180, 252); background: rgb(30, 41, 59); border-color: rgb(51, 65, 85); }

.dark .verified-reviews .btn-show-more:hover { color: rgb(255, 255, 255); background: rgb(79, 70, 229); border-color: rgb(79, 70, 229); }

.verified-reviews .btn-show-less { color: rgb(148, 163, 184); cursor: pointer; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 12px; width: 100%; margin-top: 8px; padding: 10px; font-size: 13px; font-weight: 500; transition: color 0.18s; }

