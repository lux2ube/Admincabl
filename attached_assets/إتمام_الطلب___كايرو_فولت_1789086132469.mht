:root { --background: #fff; --foreground: #0f172a; --brand-anker: #00a4e4; --brand-joyroom: #e60012; --font-sans: var(--font-cairo); --font-outfit: var(--font-cairo); }

.dark { --background: #0f172a; --foreground: #f8fafc; --brand-anker: #00a4e4; --brand-joyroom: #e60012; }

body { background: var(--background); color: var(--foreground); font-family: var(--font-sans),Tahoma,system-ui,sans-serif; }

body, html { width: 100%; max-width: 100vw; overflow-x: hidden; }

.touch-target { min-width: 44px; min-height: 44px; }

*, ::after, ::before { box-sizing: border-box; }

.cv-auto { contain-intrinsic-size: auto 500px; }

.cv-auto, .cv-auto-sm { content-visibility: auto; }

.cv-auto-sm { contain-intrinsic-size: auto 200px; }

.scrollbar-hide { scrollbar-width: none; }

.scrollbar-hide::-webkit-scrollbar { display: none; }

@media (max-width: 380px) {
  .text-xs { font-size: 0.7rem; }
  .p-3 { padding: 0.625rem; }
  .gap-3 { gap: 0.5rem; }
}

@keyframes hero-float { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-12px); }
}

.animate-hero-float { will-change: transform; animation: 4s ease-in-out 0s infinite normal none running hero-float; }

@keyframes trust-pulse { 
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.1); }
}

.animate-trust-pulse { animation: 3s ease-in-out 0s infinite normal none running trust-pulse; }

@keyframes social-ticker { 
  0% { transform: translate(0px); }
  100% { transform: translate(-50%); }
}

.animate-social-ticker { will-change: transform; animation: 40s linear 0s infinite normal none running social-ticker; }

.animate-social-ticker:hover { animation-play-state: paused; }

@keyframes shimmer { 
  0% { background-position: -200% 0px; }
  100% { background-position: 200% 0px; }
}

.animate-shimmer { background: linear-gradient(90deg, rgba(0, 0, 0, 0) 25%, rgba(255, 255, 255, 0.05) 50%, rgba(0, 0, 0, 0) 75%) 0px 0px / 200% 100%; animation: 2s ease-in-out 0s infinite normal none running shimmer; }

@media (prefers-reduced-motion: reduce) {
  .animate-hero-float, .animate-social-ticker, .animate-trust-pulse { animation: auto ease 0s 1 normal none running none; }
}

