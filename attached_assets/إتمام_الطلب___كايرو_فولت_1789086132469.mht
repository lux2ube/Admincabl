.verified-reviews .reviews-list { flex-direction: column; gap: 14px; display: flex; }

.verified-reviews .review-card { background: rgb(255, 255, 255); border: 1px solid rgb(238, 242, 247); border-radius: 16px; padding: 20px; transition: box-shadow 0.18s, transform 0.18s, border-color 0.18s; box-shadow: rgba(16, 24, 40, 0.05) 0px 1px 2px; }

