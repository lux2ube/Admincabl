.dark .verified-reviews .review-author__name { color: rgb(241, 245, 249); }

.verified-reviews .verified-badge { color: rgb(21, 128, 61); white-space: nowrap; background: rgb(220, 252, 231); border-radius: 20px; padding: 2px 8px; font-size: 11px; font-weight: 600; }

.dark .verified-reviews .verified-badge { color: rgb(74, 222, 128); background: rgba(21, 128, 61, 0.18); }

.verified-reviews .review-meta { align-items: center; gap: 10px; display: flex; }

.verified-reviews .review-date { color: rgb(148, 163, 184); font-size: 12.5px; }

.verified-reviews .review-title { color: rgb(31, 41, 55); margin: 4px 0px 8px; font-size: 16px; font-weight: 700; }

.dark .verified-reviews .review-title { color: rgb(226, 232, 240); }

.verified-reviews .review-text { color: rgb(71, 85, 105); white-space: pre-line; margin-bottom: 12px; line-height: 1.75; }

.dark .verified-reviews .review-text { color: rgb(203, 213, 225); }

.verified-reviews .review-pros-cons { flex-wrap: wrap; gap: 24px; margin-bottom: 12px; display: flex; }

