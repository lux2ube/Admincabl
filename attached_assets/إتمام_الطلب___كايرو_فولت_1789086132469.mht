.verified-reviews .btn-show-more { color: rgb(79, 70, 229); cursor: pointer; background: rgb(255, 255, 255); border: 1px solid rgb(226, 232, 240); border-radius: 12px; width: 100%; margin-top: 16px; padding: 13px; font-size: 14px; font-weight: 600; transition: 0.18s; }

