.verified-reviews .aggregate-rating { background: rgb(255, 255, 255); border: 1px solid rgb(238, 242, 247); border-radius: 16px; align-items: center; gap: 18px; margin-bottom: 24px; padding: 20px 24px; display: flex; box-shadow: rgba(16, 24, 40, 0.06) 0px 1px 3px; }

