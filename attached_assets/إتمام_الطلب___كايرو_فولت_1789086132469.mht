.dark .verified-reviews .btn-show-more:hover { color: rgb(255, 255, 255); background: rgb(79, 70, 229); border-color: rgb(79, 70, 229); }

.verified-reviews .btn-show-less { color: rgb(148, 163, 184); cursor: pointer; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 12px; width: 100%; margin-top: 8px; padding: 10px; font-size: 13px; font-weight: 500; transition: color 0.18s; }

