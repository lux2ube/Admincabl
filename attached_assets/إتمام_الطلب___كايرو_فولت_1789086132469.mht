.dark .verified-reviews--empty { background: rgb(15, 23, 42); }

.verified-reviews .section-title { color: rgb(31, 41, 55); margin-bottom: 8px; font-size: 22px; font-weight: 700; }

.dark .verified-reviews .section-title { color: rgb(241, 245, 249); }

.verified-reviews .review-disclosure { color: rgb(100, 116, 139); max-width: 760px; margin: 0px 0px 24px; font-size: 13px; line-height: 1.7; }

